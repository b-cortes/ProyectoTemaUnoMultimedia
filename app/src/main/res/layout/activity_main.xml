<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".MainActivity">

    <!-- Botón para volver a la configuración (arriba a la derecha) -->
    <ImageButton
        android:id="@+id/btnConfig"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/dorado"
        android:backgroundTint="@color/fondo_claro"
        android:contentDescription="@string/configuracion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="200dp"
        android:layout_height="260dp"
        android:layout_marginTop="90dp"
        android:src="@drawable/imagen_principal"
        android:scaleType="centerCrop"
        android:contentDescription="@string/imagen_principal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/bienvenida"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/dorado"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Primera fila: llamada y web -->
    <ImageButton
        android:id="@+id/btnLlamada"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_call"
        android:tint="@color/dorado"
        android:backgroundTint="@color/principal"
        android:contentDescription="@string/llamada"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnUrl"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <ImageButton
        android:id="@+id/btnUrl"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="40dp"
        android:src="@drawable/ic_web"
        android:tint="@color/azul_magia"
        android:backgroundTint="@color/principal"
        android:contentDescription="@string/web"
        app:layout_constraintTop_toTopOf="@id/btnLlamada"
        app:layout_constraintStart_toEndOf="@id/btnLlamada"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Segunda fila: alarma y compartir -->
    <ImageButton
        android:id="@+id/btnAlarma"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_alarm"
        android:tint="@color/azul_magia"
        android:backgroundTint="@color/principal"
        android:contentDescription="@string/alarma"
        app:layout_constraintTop_toBottomOf="@id/btnLlamada"
        app:layout_constraintStart_toStartOf="@id/btnLlamada"
        app:layout_constraintEnd_toEndOf="@id/btnLlamada" />

    <ImageButton
        android:id="@+id/btnCompartir"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_share"
        android:tint="@color/dorado"
        android:backgroundTint="@color/principal"
        android:contentDescription="@string/compartir"
        app:layout_constraintTop_toTopOf="@id/btnAlarma"
        app:layout_constraintStart_toStartOf="@id/btnUrl"
        app:layout_constraintEnd_toEndOf="@id/btnUrl" />

</androidx.constraintlayout.widget.ConstraintLayout>
