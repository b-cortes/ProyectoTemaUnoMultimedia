<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/fondo"
    tools:context=".UrlActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp">

        <!-- Volver arriba a la izquierda -->
        <Button
            android:id="@+id/btnVolverUrl"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-16dp"
            android:text="@string/volver_flecha"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/texto_suave" />

        <!-- Icono y título -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/url_titulo"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/azul_magia" />
        </LinearLayout>

        <!-- Subtítulo (se rellena desde el código) -->
        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@color/texto_suave" />

        <!-- Campo de la URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:letterSpacing="0.15"
            android:text="@string/label_url"
            android:textColor="@color/dorado"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:inputType="textUri"
            android:textColor="@color/texto"
            android:textColorHint="@color/texto_suave"
            android:backgroundTint="@color/principal" />

        <Button
            android:id="@+id/btnIr"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="48dp"
            android:text="@string/ir_web"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/azul_magia"
            android:textColor="@color/fondo" />

    </LinearLayout>

</ScrollView>
